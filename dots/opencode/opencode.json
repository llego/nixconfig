{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "mcp": {
      "ha-mcp": {
        "type": "remote",
        "url": "https://ha-mcp.llego.me/mcp",
        "enabled": true,
        "headers": {
          "Authorization": "{env:HA_MCP_TOKEN}"
        }
      },
      "nixos": {
        "type": "local",
        "command": ["nix", "run", "github:utensils/mcp-nixos", "--"],
        "enabled": true
      }
    },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.md": "allow",
      "README*": "allow",
      "AGENTS*": "allow",
      "HANDOFF*": "allow"
    },
    "edit": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "pwd *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "hostname": "allow",
      "hostname *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "curl": "allow",
      "curl *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "nix flake show": "allow",
      "nix flake show *": "allow",
      "nix flake metadata": "allow",
      "nix flake metadata *": "allow",
      "nix eval *": "allow",
      "nix search *": "allow",
      "nix path-info *": "allow",
      "docker version": "allow",
      "docker info": "allow",
      "docker ps": "allow",
      "docker ps *": "allow",
      "docker images": "allow",
      "docker images *": "allow",
      "docker volume ls": "allow",
      "docker network ls": "allow",
      "docker logs *": "allow",
      "docker inspect *": "allow",
      "docker stats": "allow",
      "docker stats *": "allow",
      "docker compose ps": "allow",
      "docker compose ps *": "allow",
      "docker compose logs *": "allow",
      "docker compose config": "allow",
      "docker compose config *": "allow",
      "journalctl *": "allow",
      "systemctl status *": "allow",
      "systemctl is-active *": "allow",
      "systemctl is-enabled *": "allow",
      "systemctl list-units *": "allow",
      "systemctl list-unit-files *": "allow",
      "systemctl show *": "allow",
      "systemctl start *": "ask",
      "systemctl stop *": "ask",
      "systemctl restart *": "ask",
      "systemctl reload *": "ask",
      "systemctl enable *": "ask",
      "systemctl disable *": "ask",
      "systemctl daemon-reload": "ask",
      "systemctl mask *": "ask",
      "systemctl unmask *": "ask",
      "zfs list": "allow",
      "zfs list *": "allow",
      "zfs get *": "allow",
      "zfs mount": "allow",
      "zfs mount *": "allow",
      "zfs unmount *": "ask",
      "zfs snapshot *": "ask",
      "zfs send *": "ask",
      "zfs receive *": "ask",
      "zfs destroy *": "ask",
      "zfs rollback *": "ask",
      "zfs set *": "ask",
      "zpool list": "allow",
      "zpool list *": "allow",
      "zpool status": "allow",
      "zpool status *": "allow",
      "zpool get *": "allow",
      "zpool iostat": "allow",
      "zpool iostat *": "allow",
      "zpool scrub *": "ask",
      "zpool clear *": "ask",
      "zpool offline *": "ask",
      "zpool online *": "ask",
      "zpool export *": "ask",
      "zpool import *": "ask",
      "zpool destroy *": "ask",
      "docker pull *": "ask",
      "docker run *": "ask",
      "docker exec *": "ask",
      "docker stop *": "ask",
      "docker start *": "ask",
      "docker restart *": "ask",
      "docker rm *": "ask",
      "docker rmi *": "ask",
      "docker volume rm *": "ask",
      "docker network rm *": "ask",
      "docker compose up *": "ask",
      "docker compose down *": "ask",
      "docker compose restart *": "ask",
      "docker compose build *": "ask",
      "docker compose pull *": "ask",
      "nix build *": "ask",
      "nix run *": "ask",
      "nix flake check *": "ask",
      "nixos-rebuild dry-build *": "allow",
      "nixos-rebuild *": "ask",
      "nh *": "ask",
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "sudo *": "ask",
      "rm *": "ask",
      "mv *": "ask",
      "cp *": "ask",
      "which *": "allow",
      "date *": "allow"
    }
  }
}
