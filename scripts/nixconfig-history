#!/usr/bin/env bash
# Query nixconfig change history from supermemory
# Usage: nixconfig-history [host|category] [search-term]

set -e

COMMAND="${1:-help}"
SEARCH_TERM="${2:-}"

show_help() {
    cat << EOF
Usage: nixconfig-history <command> [options]

Commands:
  host <hostname>     Show changes for specific host (laptop, vps, crisuflix, rpi5)
  category <type>     Show changes by category (add, remove, fix, update, docs, etc.)
  recent [n]          Show last n commits (default: 10)
  docs                Show documentation updates (README.md, AGENTS.md)
  search <term>       Search for specific term in change history
  stats               Show change statistics

Examples:
  nixconfig-history host crisuflix
  nixconfig-history category add
  nixconfig-history recent 20
  nixconfig-history search "traefik"
  nixconfig-history docs
EOF
}

# Fallback to local log file if supermemory not available
query_local_logs() {
    local pattern="$1"
    local log_dir="$(git rev-parse --show-toplevel)/.nixconfig-changes"
    
    if [ -d "$log_dir" ]; then
        grep -r "$pattern" "$log_dir" 2>/dev/null | head -20 || echo "No local log entries found"
    else
        echo "No local change logs found"
    fi
}

case "$COMMAND" in
    host)
        if [ -z "$SEARCH_TERM" ]; then
            echo "Error: Hostname required"
            echo "Usage: nixconfig-history host <laptop|vps|crisuflix|rpi5>"
            exit 1
        fi
        
        echo "Changes for host: $SEARCH_TERM"
        echo "---"
        
        # Query supermemory
        if command -v supermemory &> /dev/null; then
            supermemory search "NIXCONFIG CHANGE" "$SEARCH_TERM" --type configuration-change --limit 20
        else
            query_local_logs "$SEARCH_TERM"
        fi
        ;;
        
    category)
        if [ -z "$SEARCH_TERM" ]; then
            echo "Error: Category required"
            echo "Categories: add, remove, fix, update, move, refactor, docs, secrets, other"
            exit 1
        fi
        
        echo "Changes in category: $SEARCH_TERM"
        echo "---"
        
        if command -v supermemory &> /dev/null; then
            supermemory search "CATEGORY: $SEARCH_TERM" --type configuration-change --limit 20
        else
            query_local_logs "CATEGORY: $SEARCH_TERM"
        fi
        ;;
        
    recent)
        local limit="${SEARCH_TERM:-10}"
        
        echo "Last $limit configuration changes"
        echo "---"
        
        if command -v supermemory &> /dev/null; then
            supermemory list --type configuration-change --limit "$limit"
        else
            query_local_logs "COMMIT:"
        fi
        ;;
        
    docs)
        echo "Documentation updates (README.md, AGENTS.md)"
        echo "---"
        
        if command -v supermemory &> /dev/null; then
            supermemory search --type documentation-update --limit 20
        else
            query_local_logs "DOCS UPDATE"
        fi
        ;;
        
    search)
        if [ -z "$SEARCH_TERM" ]; then
            echo "Error: Search term required"
            exit 1
        fi
        
        echo "Searching for: $SEARCH_TERM"
        echo "---"
        
        if command -v supermemory &> /dev/null; then
            supermemory search "$SEARCH_TERM" --type configuration-change --limit 20
        else
            query_local_logs "$SEARCH_TERM"
        fi
        ;;
        
    stats)
        echo "Configuration Change Statistics"
        echo "---"
        
        local log_dir="$(git rev-parse --show-toplevel)/.nixconfig-changes"
        
        if [ -d "$log_dir" ]; then
            echo "Total logged commits: $(grep -r "COMMIT:" "$log_dir" 2>/dev/null | wc -l)"
            echo ""
            echo "By category:"
            grep -rh "CATEGORY:" "$log_dir" 2>/dev/null | sort | uniq -c | sort -rn
            echo ""
            echo "By host:"
            grep -rh "HOSTS:" "$log_dir" 2>/dev/null | sort | uniq -c | sort -rn
        else
            echo "No local logs available"
        fi
        
        if command -v supermemory &> /dev/null; then
            echo ""
            echo "Supermemory entries:"
            supermemory list --type configuration-change --limit 1000 | wc -l
        fi
        ;;
        
    help|*)
        show_help
        ;;
esac
